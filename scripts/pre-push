#!/usr/bin/env bash
# pre-push hook for stock-scanner / quant-scanner-v8.
# Problem: the remote "v8 build" workflow periodically pushes timestamp commits
# to index.html (<head> script src ?v=...), so a bare `git push origin main`
# often fails with "updates were rejected".
# This hook auto-fetches remote main and rebases the local main branch onto it
# before pushing, removing the need for manual fetch+rebase.
#
# Install:
#   cp scripts/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push        (Unix; optional on Git Bash/Windows)
#
# Behavior:
#   - Only activates when pushing refs/heads/main.
#   - Detects if origin/main has moved ahead of the local main branch.
#   - If ahead, runs `git rebase origin/main` automatically.
#   - If the rebase has conflicts, aborts and asks the user to resolve manually.

set -euo pipefail

remote_name="$1"
remote_url="$2"

pushing_main=false
local_branch=""

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  # Only care about pushes to main.
  if [ "$remote_ref" != "refs/heads/main" ]; then
    continue
  fi

  # Skip branch deletion.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  pushing_main=true

  if [[ "$local_ref" == refs/heads/* ]]; then
    local_branch="${local_ref#refs/heads/}"
  elif [ "$local_ref" = "HEAD" ]; then
    local_branch=$(git rev-parse --abbrev-ref HEAD)
  fi
done

if [ "$pushing_main" = false ] || [ -z "$local_branch" ]; then
  exit 0
fi

echo "[pre-push] 准备推送 main → $remote_name，检查远端是否已前进..."

git fetch "$remote_name" main

if git merge-base --is-ancestor FETCH_HEAD "$local_branch"; then
  echo "[pre-push] 本地 $local_branch 已包含远端 main，直接推送。"
  exit 0
fi

echo "[pre-push] 远端 main 有更新（通常是 v8 build 时间戳提交），自动 rebase 中..."

if git rebase FETCH_HEAD "$local_branch"; then
  echo "[pre-push] ✅ rebase 完成，使用更新后的 main 继续推送。"
  exit 0
else
  echo "[pre-push] ❌ rebase 失败。请手动解决冲突后再 push。"
  exit 1
fi
