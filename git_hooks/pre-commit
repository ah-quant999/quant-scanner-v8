#!/bin/bash
# ============================================================
# pre-commit 钩子 — 阻止删除 DO_NOT_DELETE.md 中登记的"不得删除"文件
# 安装: cp git_hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#       本副本提交在 git_hooks/pre-commit，双机 pull 后各自安装即可。
#
# 2026-07-12 修复:
#   1. 原钩子读 DO_NOT_DELETE.txt，但真实清单是 DO_NOT_DELETE.md → 文件不存在直接放行，机制完全失效。
#      现优先读 .md，回退 .txt。
#   2. 原钩子用 awk -F'\t' 解析 markdown `|` 表格，提取到的"保护 token"是行首的 `|`，匹配不到任何文件。
#      现正确提取表格第一列的路径/通配符（去反引号、取首个 token），支持 `*` 通配与目录前缀 `/` 匹配。
# 2026-08-29 增强:
#   3. 新增"豁免"机制：DO_NOT_DELETE.md 中含「豁免」字样的行内、用反引号包裹的路径，
#      视为经主人确认可删除的白名单，hook 读取后对其放行（覆盖通配保护）。
#      约定写法: `> 🟢 豁免 \`data/X.js\`：原因说明`，每行一个路径、必须含「豁免」二字。
# ============================================================
set -u

ROOT="$(git rev-parse --show-toplevel)"

# 优先 .md，回退 .txt
if [ -f "$ROOT/DO_NOT_DELETE.md" ]; then
  REGISTRY="$ROOT/DO_NOT_DELETE.md"
elif [ -f "$ROOT/DO_NOT_DELETE.txt" ]; then
  REGISTRY="$ROOT/DO_NOT_DELETE.txt"
else
  # 清单不存在则放行
  exit 0
fi

# 本次提交中被删除(状态 D)的文件
DELETED="$(git diff --cached --name-only --diff-filter=D)"
if [ -z "$DELETED" ]; then
  exit 0
fi

# 解析受保护清单: 从 markdown 表格提取第一列的路径/通配符
PROTECTED="$(grep -vE '^[[:space:]]*#' "$REGISTRY" \
  | grep -vE '^[[:space:]]*$' \
  | grep -E '\|' \
  | grep -vE '^\|[[:space:]]*-+\|' \
  | while IFS= read -r line; do
      cell=$(echo "$line" | sed -E 's/^[[:space:]]*\|[[:space:]]*//; s/[[:space:]]*\|.*$//')
      cell=$(echo "$cell" | tr -d '`')
      tok=$(echo "$cell" | awk '{print $1}')
      [ -z "$tok" ] && continue
      [[ "$tok" == -* ]] && continue
      [[ "$tok" == "*"* || "$tok" == "#"* ]] && continue
      echo "$tok"
    done)"

# 解析豁免清单: 文档中含「豁免」字样的行内、反引号包裹的路径
EXEMPT="$(grep -E '豁免' "$REGISTRY" \
  | grep -oE '`[^`]+`' \
  | tr -d '`' \
  | sort -u)"

is_exempt() {
  local del="$1"
  [ -z "$EXEMPT" ] && return 1
  while IFS= read -r ex; do
    [ -z "$ex" ] && continue
    if [[ "$ex" == *"*"* ]]; then
      [[ "$del" == $ex ]] && return 0
    else
      [ "$del" = "$ex" ] && return 0
    fi
  done <<< "$EXEMPT"
  return 1
}

VIOLATIONS=""
while IFS= read -r tok; do
  [ -z "$tok" ] && continue
  while IFS= read -r del; do
    [ -z "$del" ] && continue
    # 命中豁免白名单则跳过（主人已在 DO_NOT_DELETE.md 确认放行）
    is_exempt "$del" && continue
    if [[ "$tok" == *"*"* ]]; then
      if [[ "$del" == $tok ]]; then
        VIOLATIONS="${VIOLATIONS}  - ${del}  (匹配保护规则: ${tok})\n"
      fi
    elif [[ "$tok" == */ ]]; then
      if [[ "$del" == "${tok}"* ]]; then
        VIOLATIONS="${VIOLATIONS}  - ${del}  (匹配保护目录: ${tok})\n"
      fi
    else
      if [ "$del" = "$tok" ]; then
        VIOLATIONS="${VIOLATIONS}  - ${del}\n"
      fi
    fi
  done <<< "$DELETED"
done <<< "$PROTECTED"

if [ -n "$VIOLATIONS" ]; then
  echo ""
  echo "🛑 提交被阻止: 检测到试图删除受保护(不得删除)的文件!"
  echo "   这些文件在 $REGISTRY 中被标记为严禁删除。"
  printf "%b" "$VIOLATIONS"
  echo ""
  echo "   如需删除,请先在 $REGISTRY 加入「豁免」条目并经确认后再提交。"
  echo ""
  exit 1
fi

exit 0
