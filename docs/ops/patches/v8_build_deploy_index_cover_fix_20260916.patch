# v8_build_deploy.yml —— index.html 覆盖源修复补丁（2026-09-16 阿狸咪的工程师）
#
# 为什么给补丁而不是直推：
#   经 PAT（Git Data API）创建含 .github/workflows/ 路径的 tree 会被 GitHub 拒绝：
#   HTTP 403 {"message":"Resource not accessible by personal access token"} ——
#   fine-grained PAT 缺 Workflows 写权限（同 token 写非 workflow 路径均 201 成功，已实测）。
#   故本修复以补丁形式入仓，请由**具备 workflow 写权限**的通道落盘。
#
# 应用方式（在仓库根目录）：
#   git apply docs/ops/patches/v8_build_deploy_index_cover_fix_20260916.patch
#
# 改动内容（两处，均为「无条件备份-盖回」→「仅在有未提交改动时备份-盖回」）：
#   L205-207 主路径 / L340-342 重试路径
#
# 已验证：YAML 解析通过（jobs=gate,build / steps=11）；9 个 run 块 bash -n 全过；
#         干跑四用例 —— CI 干净 checkout 下旧逻辑得旧版 A、新逻辑得最新 B；
#         有未提交改动时两者都保住 MANUAL（原保护意图未削）。
#
# 背景：CI 工作区恒干净，原写法备份到的是**已提交版**而非「人工未提交改动」；
#       一旦该 run 自触发到执行此刻期间远端有新 push，旧 index.html 就会盖回新版本，
#       随后 git add index.html + push 因 fast-forward 而成功 ⇒ 静默覆盖他人前端改动。
#       （实测 2026-09-16 13:16-13:20 四分钟 6 次推送，该窗口极易命中。）

--- a/.github/workflows/v8_build_deploy.yml
+++ b/.github/workflows/v8_build_deploy.yml
@@ -202,9 +202,20 @@
             #   iframe 加载兜底、子 tab 顺序调整、卡片增删）全部擦回远端旧版。此处先备份
             #   本地 index.html，reset 后立即恢复；后续 update_v8.py 只会更新 data/*.js
             #   的 ?v 戳、guard_v6_memo.py 只会刷新 v6_memo.html 的戳，不会破坏人工改动。
-            cp index.html /tmp/index.html.manual
-            git reset --hard FETCH_HEAD
-            cp /tmp/index.html.manual index.html
+            # 🛡🛡 2026-09-16 一劳永逸（阿狸咪的工程师）·覆盖源修复：
+            #   ⚠️ 上述「无条件备份 → reset → 盖回」在 CI 里备份到的是**checkout 时的已提交版**
+            #   （CI 工作区恒干净，没有『人工未提交改动』可保护）。若本 run 自触发到执行此刻期间
+            #   远端有新 push（实测 13:16-13:20 四分钟 6 次推送），FETCH_HEAD 会前进，于是
+            #   **旧 index.html 被盖回新版本**，随后 git add index.html + push 因 fast-forward
+            #   而成功 ⇒ 静默覆盖他人前端改动。这正是「改好又被盖回旧版」的机制之一。
+            #   改为**仅在确有未提交改动时**才备份/恢复：原保护意图不变，覆盖漏洞消除。
+            if ! git diff --quiet -- index.html; then
+              cp index.html /tmp/index.html.manual
+              git reset --hard FETCH_HEAD
+              cp /tmp/index.html.manual index.html
+            else
+              git reset --hard FETCH_HEAD
+            fi
             # 同步 cn runner 单独推送的 5 个 extra 文件（update_v8.py 不重建这些），
             #   确保 ?v 计算基于线上真实最新内容。
             git checkout FETCH_HEAD -- data/FOUR_VOLUME.js data/FOUR_VOLUME_60M.js data/STOCK_STOP_DATA.js data/FINAL_RECOMMEND_DATA.js
@@ -337,9 +348,15 @@
             echo "⚠️ push 被拒（远端已前进），同步远端并按最新 raw_data 全量重建后重试 ($i/3)"
             git fetch "$REPO" main
             # 重试路径同样备份/恢复 index.html，避免人工前端改动被擦除
-            cp index.html /tmp/index.html.manual
-            git reset --hard FETCH_HEAD
-            cp /tmp/index.html.manual index.html
+            # 🛡🛡 2026-09-16 一劳永逸（阿狸咪的工程师）·同上：重试路径存在同一覆盖源，
+            #   改为仅在确有未提交改动时才备份/恢复（原因见上方主路径注释）。
+            if ! git diff --quiet -- index.html; then
+              cp index.html /tmp/index.html.manual
+              git reset --hard FETCH_HEAD
+              cp /tmp/index.html.manual index.html
+            else
+              git reset --hard FETCH_HEAD
+            fi
             git checkout FETCH_HEAD -- data/FOUR_VOLUME.js data/FOUR_VOLUME_60M.js data/STOCK_STOP_DATA.js data/FINAL_RECOMMEND_DATA.js
             # 🔴 2026-08-18 根因修复：重试路径同样必须全量构建，不能用 --detect-changes
             #   （原因同上：reset 后 HEAD~1..HEAD 已无法反映 raw_data 的真实变化）。
